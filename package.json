{
  "name": "apush-unit4-flashcards",
  "private": true,
  "version": "2.0.0",
  "description": "APUSH Unit 4 (1800–1848) flashcards: 286 curated cards in topic baskets, with practice, spaced review and typed answers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate": "vitest run src/lib/__tests__/deck.test.ts",
    "test": "vitest run",
    "deck:md": "node scripts/deck-md.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
